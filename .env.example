# VaultX Configuration
PORT=3000
HOST=localhost

# 256-bit Hex Master Key (64 hex characters)
# If left empty, VaultX generates a cryptographically random 256-bit key in memory on startup.
# Master key is NEVER stored in database or logged.
VAULTX_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database location
VAULTX_DB_PATH=./data/vaultx.db
